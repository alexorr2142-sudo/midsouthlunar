{
  "name": "midsouthlunar",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:perf": "node scripts/perf.mjs",
    "test:report": "vitest run --reporter=json --outputFile=test-results/unit.json; playwright test --reporter=json > test-results/e2e.json; node scripts/perf.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "chat": "node --env-file-if-exists=.env server/chat.mjs",
    "chat:worker": "wrangler dev",
    "chat:deploy": "wrangler deploy"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "chrome-launcher": "^1.2.2",
    "jsdom": "^30.1.2",
    "lighthouse": "^13.5.0",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
